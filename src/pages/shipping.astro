---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { shipToList } from '../lib/checkout-form';
import { pageTitle } from '../lib/seo';
import Money from '../components/Money.astro';
import FreeShippingFrom from '../components/FreeShippingFrom.astro';
import { SHIPPING_FLAT } from '../lib/money';
---
<BaseLayout alternates={[{ lang: 'en', href: '/shipping/' }, { lang: 'de', href: '/de/versand/' }]} title={pageTitle('Shipping and returns')} description={`Shipping costs €6, free on orders of €50 or more, or when you buy two or more from a bundle. Made to order, ships in ${site.shipsIn} with tracking. Delivery times by country. 30-day returns.`}>
  <article class="container narrow prose">
    <header class="page-head"><h1>Shipping and returns</h1></header>

    <h2>Buying on this website</h2>
    <ul>
      <li><strong>Cost:</strong> <Money eur={SHIPPING_FLAT.EUR / 100} gbpCents={SHIPPING_FLAT.GBP} usdCents={SHIPPING_FLAT.USD} /> per order. Free on orders of <FreeShippingFrom /> or more.</li>
      <li><strong>Bundles:</strong> buy two or more of the same <a href="/shop/bags/">character bag</a>, <a href="/go/petal-pockets/">Petal Pockets flower bag</a> or <a href="/go/fruit-bellies/">Fruit Bellies coaster</a>, a set of four or six <a href="/go/fold-and-bloom/">Fold &amp; Bloom carnations</a>, the <a href="/go/pearl-and-daisy/">Pearl &amp; Daisy</a> big and little set, both <a href="/go/bamboo-buddies/">Bamboo Buddies</a> pandas, a set of four or six <a href="/go/potted-roses/">Potted Roses</a>, or a pack of six or eight <a href="/go/mandala-blooms/">Mandala Blooms</a>, and shipping is free, whatever the total.</li>
      <li><strong>Processing:</strong> every piece is made to order and ships within {site.shipsIn}.</li>
      <li><strong>Tracking:</strong> every parcel is tracked, and we email you the tracking number when it ships.</li>
    </ul>

    <h3>Delivery times</h3>
    <div class="table-wrap">
      <table class="ship-table">
        <thead><tr><th scope="col">Destination</th><th scope="col">Carrier</th><th scope="col">Delivery after dispatch</th></tr></thead>
        <tbody>
          {site.delivery.map((d) => <tr><th scope="row">{d.region}</th><td>{d.carrier}</td><td>{d.days} working days</td></tr>)}
        </tbody>
      </table>
    </div>
    <p>Delivery times count from the day your parcel ships, so add {site.shipsIn} for making and packing.</p>
    <p>We ship to {shipToList}.</p>
    <p>
      There are no import charges to pay on delivery to the EU, the UK or the US. The price you see at checkout is
      the full price. Other countries may charge their own import fees on arrival.
    </p>

    <h2 id="returns">Returns</h2>
    <p>
      You can return any item within 30 days of delivery (60 days for <a href="/go/finn-the-shamrock/">Finn &amp; the Shamrock</a>). You pay the return postage, and we refund the item
      price plus the original shipping within 14 days of receiving it back, or of you sending us proof of postage if
      that comes first. Full details, including how to
      cancel, are on our <a href="/terms/">terms of sale</a> page.
    </p>

  </article>
</BaseLayout>
