---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEnv } from '../../lib/env';
import { loadCatalog } from '../../lib/catalog';
import { BAG_COOKIE, decodeBag, saveBag } from '../../lib/bag-cookie';
import { displayCents, priceBag } from '../../lib/pricing';
import { CURRENCY_COOKIE, currencyFromRequest, formatMoney } from '../../lib/currency';
import { pageTitle } from '../../lib/seo';
import { unitLabel } from '../../lib/line-label';
import { LANG_COOKIE, langFrom } from '../../i18n/lang';
import { SHOP_UI } from '../../i18n/shop-ui';
import { shownLine } from '../../i18n/de/lines';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');
const env = getEnv();
const catalog = await loadCatalog((p) => env.ASSETS.fetch(new Request(new URL(p, Astro.request.url))));
const bag = await decodeBag(Astro.cookies.get(BAG_COOKIE)?.value, env.BAG_SECRET);
const currency = currencyFromRequest(Astro.cookies.get(CURRENCY_COOKIE)?.value, Astro.request);
const priced = priceBag(bag, catalog, currency);
if (priced.dropped.length) {
  const kept = priced.lines.map((l) => (l.option ? { slug: l.slug, option: l.option, qty: l.qty } : { slug: l.slug, qty: l.qty }));
  await saveBag(Astro.cookies, kept, env.BAG_SECRET);
}
const notice = Astro.url.searchParams.get('n');
const cancelled = Astro.url.searchParams.get('cancelled') === '1';
const declined = Astro.url.searchParams.get('declined') === '1';
// German if the shopper last came from a German page.
const lang = langFrom(Astro.cookies.get(LANG_COOKIE)?.value);
const U = SHOP_UI[lang].bag;
const curName = SHOP_UI[lang].currencyNames[currency];
const euro = (c: number) => formatMoney(c, currency, lang);
/** Bundle pages have German versions: link a German shopper back to theirs. */
const deHref = (href: string) => (lang === 'de' && href.startsWith('/go/') ? `/de${href}` : href);
const suggestions = Object.values(catalog)
  .filter((i) => i.featured !== null && i.inStock && !priced.lines.some((l) => l.slug === i.slug))
  .sort((a, b) => (a.featured ?? 9) - (b.featured ?? 9))
  .slice(0, 4);
---
<BaseLayout title={pageTitle(U.title)} description={U.description} path="/bag/" noindex lang={lang}>
  <div class="container narrow-wide">
    <header class="page-head"><h1>{U.h1}</h1></header>
    {notice === 'added' && <p class="notice" role="status">{U.added}</p>}
    {notice === 'invalid' && <p class="notice notice-warn" role="status">{U.invalid}</p>}
    {cancelled && <p class="notice" role="status">{U.cancelled}</p>}
    {declined && <p class="notice notice-warn" role="alert">{U.declined}</p>}
    {priced.dropped.length > 0 && <p class="notice notice-warn" role="status">{U.dropped(priced.dropped.join(', '))}</p>}
    {priced.lines.length === 0 ? (
      <div class="bag-empty">
        <p>{U.empty}</p>
        <p><a class="btn btn-primary" href="/shop/bags/">{U.browse}</a> <a class="btn-ghost" href="/shop/">{U.all}</a></p>
      </div>
    ) : (
      <div class="bag-grid">
        <ul class="bag-lines" role="list">
          {priced.lines.map((line, i) => { const l = shownLine(line, lang); return (
            <li class="bag-line">
              <img src={l.thumb} alt="" width="80" height="80" loading="lazy" />
              <div class="bag-line-info">
                <a href={deHref(catalog[l.slug]?.href ?? `/products/${l.slug}/`)}>{l.name}</a>
                {l.option && <span class="small muted">{l.option}</span>}
                <span class="small">{unitLabel(line, euro(l.unitCents), lang)}</span>
              </div>
              <form method="post" action="/bag/update/" class="bag-qty">
                <input type="hidden" name="index" value={i} />
                <label><span class="visually-hidden">{U.qtyFor(l.name)}</span>
                  <select name="qty">{[1, 2, 3, 4, 5].map((n) => <option value={n} selected={n === l.qty}>{n}</option>)}</select>
                </label>
                <button type="submit" class="btn-ghost" aria-label={U.updateFor(l.name)}>{U.update}</button>
              </form>
              <form method="post" action="/bag/remove/">
                <input type="hidden" name="index" value={i} />
                <button type="submit" class="btn-ghost" aria-label={U.removeFor(l.name)}>{U.remove}</button>
              </form>
              <span class="bag-line-total">{euro(l.lineCents)}</span>
            </li>
          ); })}
        </ul>
        <aside class="bag-summary" aria-label={U.summary}>
          <dl>
            <div><dt>{U.subtotal}</dt><dd>{euro(priced.subtotalCents)}</dd></div>
            <div><dt>{U.shipping}</dt><dd>{priced.shippingCents === 0 ? U.free : euro(priced.shippingCents)}</dd></div>
            <div class="bag-total"><dt>{U.total}</dt><dd>{euro(priced.totalCents)}</dd></div>
          </dl>
          {priced.freeShippingGapCents > 0 && <p class="small">{U.gap(euro(priced.freeShippingGapCents))}</p>}
          <p class="small muted">{U.currencyNote(curName)}</p>
          <a class="btn btn-primary btn-block" href="/checkout/">{U.checkout}</a>
          <a class="btn-ghost" href="/shop/">{U.continue}</a>
        </aside>
      </div>
    )}
    {(priced.lines.length === 0 || priced.freeShippingGapCents > 0) && suggestions.length > 0 && (
      <section class="section" aria-labelledby="suggest-h">
        <h2 id="suggest-h">{U.popular}</h2>
        <ul class="grid" role="list">
          {suggestions.map((s) => (
            <li><a class="card card-link" href={deHref(s.href ?? `/products/${s.slug}/`)}><img src={s.thumb} alt="" width="160" height="160" loading="lazy" /><span class="card-title">{s.name}</span><span class="card-price">{euro(displayCents(s, currency))}</span></a></li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
