---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { GIFT_GUIDES } from '../../data/gift-guides';
import FaqList from '../../components/FaqList.astro';
import { breadcrumbJsonLd, faqJsonLd, itemListJsonLd, pageTitle } from '../../lib/seo';

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Gift guides', path: '/gifts/' }];
const faq = [
  { q: 'Are the gifts really handmade?', a: 'Yes. Every piece in the shop is crocheted by hand by Hui, stitch by stitch, and made to order, so no two are exactly alike.' },
  { q: 'Can I send a gift straight to the person?', a: 'Yes. Enter their address at checkout and we ship it to them with tracking.' },
  { q: 'Will it arrive in time for Christmas?', a: 'Every piece ships within 3 to 5 days. Delivery then takes 5 to 8 working days to the UK, 6 to 12 to the US and Canada, 6 to 14 to the EU and 7 to 12 to Ireland. To be safe, order by 1 December.' },
  { q: 'Will they have to pay import charges?', a: 'No. There are no import charges to pay on delivery to the EU, the UK or the US.' },
];
---
<BaseLayout
  alternates={[{ lang: 'en', href: '/gifts/' }, { lang: 'de', href: '/de/geschenke/' }]}
  title={pageTitle('Handmade gifts: crochet gift ideas')}
  description="Handmade gifts, crocheted by hand: Christmas gifts, gifts for frog, dog and cat lovers, coaster sets and gifts under €40. No import fees to the EU, UK or US."
  jsonLd={[breadcrumbJsonLd(crumbs), itemListJsonLd('Handmade gifts', GIFT_GUIDES.map((g) => `/gifts/${g.slug}/`)), faqJsonLd(faq)!]}
>
  <div class="container narrow prose">
    <Breadcrumbs items={crumbs} />
    <header class="page-head">
      <h1>Handmade gifts</h1>
      <p>Gifts a person made: every bag, coaster and hat in the shop is crocheted by hand by Hui. These guides group them by who you're buying for.</p>
    </header>
    <ul role="list" class="gift-guides">
      {GIFT_GUIDES.map((g) => (
        <li><h2><a href={`/gifts/${g.slug}/`}>{g.h1}</a></h2><p>{g.intro}</p></li>
      ))}
    </ul>
    <FaqList items={faq} heading="Good to know" />
  </div>
</BaseLayout>
