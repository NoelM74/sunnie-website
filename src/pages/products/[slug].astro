---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BuyBox from '../../components/BuyBox.astro';
import FaqList from '../../components/FaqList.astro';
import Gallery from '../../components/Gallery.astro';
import Money from '../../components/Money.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { site } from '../../data/site';
import { CATEGORY_LABELS, related } from '../../lib/products';
import { FREE_SHIPPING_THRESHOLD_CENTS, SHIPPING_FLAT_CENTS } from '../../lib/money';
import { Picture } from 'astro:assets';
import huiPhoto from '../../assets/story/hui.jpg';
import { absoluteUrl, breadcrumbJsonLd, faqJsonLd, firstSentences, metaDescription, productJsonLd, productTitle } from '../../lib/seo';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({ params: { slug: product.id }, props: { product, all: products } }));
}

interface Props {
  product: CollectionEntry<'products'>;
  all: CollectionEntry<'products'>[];
}
const { product, all } = Astro.props;
const d = product.data;
const { Content } = await render(product);

const path = `/products/${product.id}/`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: CATEGORY_LABELS[d.category], path: `/shop/${d.category}/` },
  { name: d.name, path },
];
const ldImages = await Promise.all(
  d.images.slice(0, 3).map(async (img) => absoluteUrl((await getImage({ src: img.src, width: 1200, format: 'jpg' })).src)),
);
const description = metaDescription(firstSentences(product.body ?? d.name, 2));
const current = d.category;
const colourOption = d.options.find((o) => o.name === 'Colour');
const color = colourOption ? colourOption.values.join(', ') : undefined;
const material = d.materials.length > 0 ? d.materials.join(', ') : undefined;
const faq = faqJsonLd(d.faq);
const optionPriceValues = d.optionPrices ? Object.values(d.optionPrices) : undefined;
const lowestOptionPrice = optionPriceValues ? Math.min(...optionPriceValues) : undefined;
const fromPrefix = lowestOptionPrice !== undefined ? 'From ' : '';
const shownPrice = lowestOptionPrice ?? d.price;
const canBuy = d.inStock && d.siteCheckout;
---
<BaseLayout
  title={productTitle(d.name)}
  description={description}
  path={path}
  image={ldImages[0]}
  type="product"
  current={current}
  jsonLd={[
    productJsonLd({
      name: d.name,
      description,
      url: absoluteUrl(path),
      images: ldImages,
      price: d.price,
      inStock: d.inStock,
      sku: product.id,
      material,
      color,
      category: CATEGORY_LABELS[d.category],
      optionPrices: optionPriceValues,
    }),
    breadcrumbJsonLd(crumbs),
    ...(faq ? [faq] : []),
  ]}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <div class="product">
      <Gallery images={d.images} name={d.name} />
      <div class="product-info">
        {d.isNew && d.inStock && <span class="badge">New</span>}
        <h1>{d.name}</h1>
        <p class="product-price">{fromPrefix}<Money eur={shownPrice} /></p>
        <p class="product-proof"><span class="hero-stars" aria-hidden="true">★★★★★</span> {site.proof.etsyRating} on Etsy · {site.proof.ebayPositive} positive from {site.proof.ebayCount} eBay ratings</p>
        <BuyBox slug={product.id} option={d.options[0]} inStock={d.inStock} etsyUrl={d.etsyUrl} siteCheckout={d.siteCheckout} optionPrices={d.optionPrices} maker={d.maker} alts={d.images.map((i) => i.alt)} optionPhotos={d.optionPhotos} />
        {d.maker === 'Hui' && (
          <a class="maker-strip" href="/our-story/">
            <Picture src={huiPhoto} alt="" widths={[96, 192]} sizes="48px" formats={['webp']} class="maker-photo" />
            <span><strong>Made by Hui</strong>, stitch by stitch. Every piece is a little different, because each one is made by hand. Yours will be the only one exactly like it. <span class="maker-more">Meet Hui</span></span>
          </a>
        )}
      </div>
    </div>
    <div class="product-details">
      <div class="prose product-body"><Content /></div>
      <div class="product-more">
        <details class="fold" open>
          <summary>Size and materials</summary>
          <ul class="product-facts" role="list">
            {d.size && <li><strong>Size:</strong> {d.size}</li>}
            {d.materials.length > 0 && <li><strong>Materials:</strong> {d.materials.join(', ')}</li>}
            <li><strong>Ships in:</strong> {site.shipsIn}</li>
          </ul>
        </details>
        <details class="fold">
          <summary>Delivery and returns</summary>
          <p>Made to order and shipped in {site.shipsIn} with tracking. Shipping costs <Money eur={SHIPPING_FLAT_CENTS / 100} />, and it's free on orders of <Money eur={FREE_SHIPPING_THRESHOLD_CENTS / 100} whole /> or more. No import charges to the EU, UK or US.</p>
          <ul class="product-facts" role="list">
            {site.delivery.map((r) => <li><strong>{r.region}:</strong> {r.days} working days</li>)}
          </ul>
          <p>Returns within 30 days. <a href="/shipping/">Shipping and returns</a></p>
        </details>
        {d.faq.length > 0 && <FaqList items={d.faq} heading="Questions" id="product-faq" accordion />}
      </div>
    </div>
    {canBuy && (
      <div class="buy-bar" data-buy-bar hidden>
        <span class="buy-bar-price">{fromPrefix}<Money eur={shownPrice} /></span>
        <button class="btn btn-primary" type="submit" form="buy-form">Add to basket</button>
      </div>
    )}
    <section class="section related" aria-labelledby="related-h">
      <h2 id="related-h">You might also like</h2>
      <ProductGrid products={related(all, product)} />
    </section>
  </div>
  {/* Phone-width buy bar: shows once the main Add to basket button scrolls out of view. */}
  <script is:inline>(function(){var bar=document.querySelector('[data-buy-bar]'),btn=document.querySelector('[data-buy-btn]');if(!bar||!btn||!('IntersectionObserver' in window))return;new IntersectionObserver(function(e){bar.hidden=e[0].isIntersecting||e[0].boundingClientRect.top>0}).observe(btn)})();</script>
</BaseLayout>
