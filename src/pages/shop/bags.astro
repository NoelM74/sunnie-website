---
import { productHref } from '../../lib/lander-products';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqList from '../../components/FaqList.astro';
import ProductBrowser from '../../components/ProductBrowser.astro';
import { categoryFaq } from '../../data/category-faq';
import { site } from '../../data/site';
import { GROUP_LABELS, GROUP_ORDER, inGroup } from '../../lib/products';
import { breadcrumbJsonLd, faqJsonLd, itemListJsonLd, pageTitle } from '../../lib/seo';

const all = await getCollection('products');
const groups = GROUP_ORDER.map((g) => ({ key: g, label: GROUP_LABELS[g], items: inGroup(all, g) })).filter((g) => g.items.length > 0);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Bags', path: '/shop/bags/' }];
const bags = groups.flatMap((g) => g.items);
const productUrls = bags.map((p) => productHref(p.id));
const faqItems = categoryFaq.bags;
const faq = faqJsonLd(faqItems);
---
<BaseLayout
  alternates={[{ lang: 'en', href: '/shop/bags/' }, { lang: 'de', href: '/de/shop/taschen/' }]}
  title={pageTitle('Crochet crossbody phone bags, animal bags and totes')}
  description={`Handmade crochet crossbody phone bags, animal bags and totes: frogs, cats, dogs, pandas and flowers, each one crocheted by hand and rated ${site.proof.etsyRating} by our buyers. Ships in ${site.shipsIn} with tracking.`}
  current="bags"
  jsonLd={[breadcrumbJsonLd(crumbs), itemListJsonLd('Crochet bags', productUrls), ...(faq ? [faq] : [])]}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <header class="page-head">
      <h1>Crochet bags: crossbody phone bags, animal bags and totes</h1>
      <p>
        Carrying a phone in your hand all day gets old fast. These crochet crossbody phone bags, animal bags and
        totes are made by hand to hold your phone, cards and keys with your hands free: frogs, cats, dogs, a panda
        and a few monsters, plus flower bags and roomy totes. Tap any bag for its size, colours and more photos.
      </p>
    </header>
    <ProductBrowser products={bags} by="group" />
    <section class="guide prose" aria-labelledby="guide-h">
      <h2 id="guide-h">How to choose a crochet bag</h2>
      <p>
        Phone bags run small on purpose. Most sit 10 to 15 cm wide with a strap between 100 and 130 cm, long enough
        to wear crossbody with your phone, cards and lip balm inside and both hands free. Totes and shoulder bags
        run bigger, 25 to 37 cm wide, with room for a water bottle, a paperback or an 11-inch tablet. The
        <a href="/products/daisy-granny-square-tote-bag-with-matching-coin/">daisy granny square tote</a> is a good
        example, with its own coin purse that clips to the handle.
      </p>
      <p>
        Looking for a crochet animal bag? The <a href="/go/star-frogs/">Star Frogs</a> and
        <a href="/go/finn-the-shamrock/">Finn &amp; the Shamrock</a> are frogs whose mouth is the opening,
        <a href="/go/miso-cat/">Miso</a> is a cat in a sweater, and <a href="/go/snout-and-about/">Snout &amp; About</a>
        and <a href="/go/fuzzy-pups/">Fuzzy Pups</a> are soft little dogs. Buy two of the same bag and shipping is
        free, with each one costing less.
      </p>
      <p>
        For a phone, check the width and fit listed on each product page: the
        <a href="/go/star-frogs/">Star Frogs</a>, for example, fit phones up to 6.7 inches. Straps vary by
        design: some are a fixed crossbody length, others adjust.
      </p>
      <p>
        Buying for someone else, a character bag like the
        <a href="/products/giraffe-crossbody-bag-for-kids/">giraffe crossbody for kids</a> or a
        <a href="/products/tassel-crossbody-phone-bag/">tassel phone bag</a> makes a gift with a story attached, and
        every piece lists its size so there's no guessing. Hand-worked yarn means a centimetre or two of variation
        from the photos, and washing instructions live on each product page.
      </p>
    </section>
    {faqItems.length > 0 && <FaqList items={faqItems} />}
  </div>
</BaseLayout>
