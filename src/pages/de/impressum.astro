---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { pageTitle } from '../../lib/seo';

// Provider details for German visitors (Impressum), from the seller facts in src/data/site.ts.
const c = site.seller;
---
<BaseLayout lang="de" title={pageTitle('Impressum')} description={`Impressum von ${c.tradingAs}: ${c.name}, Einzelunternehmer, Clonlara, Co. Clare, Irland.`}>
  <article class="container narrow prose">
    <header class="page-head"><h1>Impressum</h1></header>
    <h2>Anbieter</h2>
    <p>{c.name}, handelnd als {c.tradingAs}<br />
    Einzelunternehmer<br />
    {c.address}, Irland</p>
    <h2>Umsatzsteuer</h2>
    <p>{c.name} ist nicht umsatzsteuerpflichtig registriert und hat daher keine Umsatzsteuer-Identifikationsnummer.</p>
    <h2>Kontakt</h2>
    <p>E-Mail: <a href={`mailto:${site.email.hello}`}>{site.email.hello}</a><br />
    Telefon: <a href={`tel:${site.phone.tel}`}>{site.phone.display}</a><br />
    Wir antworten in der Regel innerhalb von 24 Stunden.</p>
  </article>
</BaseLayout>
