---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { GIFT_GUIDES } from '../../../data/gift-guides';
import { GIFT_GUIDES_DE } from '../../../i18n/de/gift-guides';
import FaqList from '../../../components/FaqList.astro';
import { breadcrumbJsonLd, faqJsonLd, itemListJsonLd, pageTitle } from '../../../lib/seo';

const guides = GIFT_GUIDES.filter((g) => GIFT_GUIDES_DE[g.slug]).map((g) => GIFT_GUIDES_DE[g.slug]);
const crumbs = [{ name: 'Startseite', path: '/de/' }, { name: 'Geschenkideen', path: '/de/geschenke/' }];
// Search Console, 26 Nov 2026: this page is found for "handgemachte geschenke" and "handgefertigte geschenke".
const faq = [
  { q: 'Sind die Geschenke wirklich handgemacht?', a: 'Ja. Jedes Stück im Shop wird von Hui von Hand gehäkelt, Masche für Masche, und auf Bestellung gemacht. Deshalb gleicht keins genau dem anderen.' },
  { q: 'Kann ich das Geschenk direkt an die beschenkte Person schicken?', a: 'Ja. Gib an der Kasse einfach ihre Adresse ein, und wir schicken es ihr mit Sendungsverfolgung.' },
  { q: 'Wie lange dauert die Lieferung nach Deutschland?', a: 'Jedes Stück wird innerhalb von 3–5 Tagen verschickt. Danach dauert die Lieferung in die EU 6 bis 14 Werktage. Für Weihnachten bestellst du am besten bis zum 1. Dezember.' },
  { q: 'Fallen Zoll oder Einfuhrabgaben an?', a: 'Nein. Bei Lieferung in die EU, nach Großbritannien oder in die USA zahlst du keine Einfuhrabgaben.' },
];
---
<BaseLayout
  lang="de"
  alternates={[{ lang: 'en', href: '/gifts/' }, { lang: 'de', href: '/de/geschenke/' }]}
  title={pageTitle('Handgemachte Geschenke: gehäkelte Geschenkideen')}
  description="Handgemachte Geschenke, von Hand gehäkelt: Weihnachtsgeschenke, Geschenke für Frosch-, Hunde- und Katzenfans, Untersetzer-Sets und Geschenke unter 40 €. Ohne Einfuhrabgaben in die EU."
  jsonLd={[breadcrumbJsonLd(crumbs), itemListJsonLd('Handgemachte Geschenke', guides.map((g) => `/de/geschenke/${g.slug}/`)), faqJsonLd(faq)!]}
>
  <div class="container narrow prose">
    <Breadcrumbs items={crumbs} />
    <header class="page-head">
      <h1>Handgemachte Geschenke</h1>
      <p>Handgefertigte Geschenke, die ein Mensch gemacht hat: Jedes Stück im Shop, ob Tasche, Untersetzer oder Mütze, ist von Hui von Hand gehäkelt. Diese Seiten sortieren sie danach, für wen du einkaufst.</p>
    </header>
    <ul role="list" class="gift-guides">
      {guides.map((g) => (
        <li><h2><a href={`/de/geschenke/${g.slug}/`}>{g.h1}</a></h2><p>{g.intro}</p></li>
      ))}
    </ul>
    <FaqList items={faq} heading="Gut zu wissen" />
  </div>
  <script is:inline>try{document.cookie='sunnie_lang=de;path=/;max-age=31536000;samesite=lax;secure'}catch(e){}</script>
</BaseLayout>
