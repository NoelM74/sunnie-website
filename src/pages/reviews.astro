---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewQuote from '../components/ReviewQuote.astro';
import reviews from '../data/reviews.json';
import { site } from '../data/site';
import { pageTitle } from '../lib/seo';

const list = reviews as ((typeof reviews)[number] & { lang: 'en' | 'de' })[];
---
<BaseLayout
  alternates={[{ lang: 'en', href: '/reviews/' }, { lang: 'de', href: '/de/bewertungen/' }]}
  title={pageTitle('Customer reviews')}
  description={`Reviews from Sunnie Designs buyers, who rate us ${site.proof.etsyRating} out of 5.`}
>
  <div class="container">
    <header class="page-head">
      <h1>What buyers say</h1>
      <p>
        Our buyers rate us {site.proof.etsyRating} out of 5, and we're {site.proof.ebayPositive}
        positive across {site.proof.ebayCount} ratings on eBay. Every quote below comes straight from a buyer's
        review, and a few long ones are shortened. German reviews show the English translation first, with the original underneath.
      </p>
    </header>
    <div class="quotes">
      {list.map((r) => <ReviewQuote review={r} showOriginal />)}
    </div>
  </div>
</BaseLayout>
