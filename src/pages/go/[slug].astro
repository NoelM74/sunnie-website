---
import LanderPage from '../../components/LanderPage.astro';
import { LANDERS, type Lander } from '../../data/landers';
import { LANDERS_DE } from '../../i18n/de/landers';

export function getStaticPaths() {
  return LANDERS.map((lander) => ({ params: { slug: lander.slug }, props: { lander } }));
}
interface Props { lander: Lander }
const { lander } = Astro.props;
const alternates = LANDERS_DE[lander.slug]
  ? [{ lang: 'en', href: `/go/${lander.slug}/` }, { lang: 'de', href: `/de/go/${lander.slug}/` }]
  : [];
---
<LanderPage lander={lander} alternates={alternates} />
