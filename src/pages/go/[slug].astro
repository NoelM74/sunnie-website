---
import { getImage, Picture } from 'astro:assets';
import LanderLayout from '../../layouts/LanderLayout.astro';
import ReviewQuote from '../../components/ReviewQuote.astro';
import reviews from '../../data/reviews.json';
import { site } from '../../data/site';
import { LANDERS, type Lander, type ReviewKey } from '../../data/landers';
import { BUNDLE_SIZES, bundleCatalogItem, bundleOption, bundleSlug, type BundleSize } from '../../lib/bundles';
import { FINN_ITEM } from '../../lib/finn';
import { priceBag } from '../../lib/pricing';
import { landerImage } from '../../lib/lander-images';
import { CURRENCIES, formatMoney, type Currency } from '../../lib/currency';
import { absoluteUrl } from '../../lib/seo';

export function getStaticPaths() {
  return LANDERS.map((lander) => ({ params: { slug: lander.slug }, props: { lander } }));
}

interface Props { lander: Lander }
const { lander: l } = Astro.props;

type Review = (typeof reviews)[number] & { lang: 'en' | 'de'; en?: string };
const findReview = (k: ReviewKey): Review => {
  const r = (reviews as Review[]).find((x) => x.reviewer === k.reviewer && x.date === k.date);
  if (!r) throw new Error(`Lander ${l.slug}: no review from ${k.reviewer} on ${k.date} in reviews.json`);
  return r;
};
const quoteText = (r: Review) => (r.lang === 'de' && r.en ? r.en : r.text);
const heroQuote = findReview(l.hero.proof);
const offerQuote = findReview(l.offer.proof);
const shown = l.reviews.map(findReview);

// Every price on the page comes from the bag's own pricing (priceBag), so the lander,
// the bag and PayPal can't disagree.
const cartSlug = l.cart?.slug ?? bundleSlug(l);
const packOption = (n: BundleSize) => (l.cart ? l.cart.options[n] : bundleOption(l, l.offer.defaults.slice(0, n))!);
if (l.cart && l.cart.slug !== FINN_ITEM.slug) throw new Error(`Lander ${l.slug}: only Finn has his own bag item`);
const cartItem = l.cart ? { ...FINN_ITEM, thumb: '' } : bundleCatalogItem(l, '');
const quote = (n: BundleSize, cur: Currency) => priceBag([{ slug: cartSlug, option: packOption(n), qty: 1 }], { [cartSlug]: cartItem }, cur);
const prices = Object.fromEntries(CURRENCIES.map((cur) => [cur, {
  1: quote(1, cur).subtotalCents, 2: quote(2, cur).subtotalCents, 3: quote(3, cur).subtotalCents,
  ship: Object.fromEntries(BUNDLE_SIZES.map((n) => [n, quote(n, cur).shippingCents])),
}])) as Record<Currency, Record<BundleSize, number> & { ship: Record<BundleSize, number> }>;
const local = (n: BundleSize, cur: Currency) => prices[cur][n];
/** A price span the BaseLayout-style swap script can switch, from a per-currency cents function. */
const money = (cents: (cur: Currency) => number) => ({
  text: formatMoney(cents('EUR'), 'EUR'),
  gbp: formatMoney(cents('GBP'), 'GBP'),
  usd: formatMoney(cents('USD'), 'USD'),
});
const bundlePrice = (n: BundleSize) => money((c) => local(n, c));
const perPiece = (n: BundleSize) => money((c) => Math.round(local(n, c) / n));
const saving = (n: BundleSize) => money((c) => local(1, c) * n - local(n, c));
const singleShip = money((c) => prices[c].ship[1]);
const from = bundlePrice(1);
const nounFor = (n: number) => (n === 1 ? l.noun[0] : l.noun[1]);
const Noun = l.noun[0][0].toUpperCase() + l.noun[0].slice(1);
const DEFAULT: BundleSize = 2;
// The step-up line above the button. Must match nudge() in the page script.
const nudge = (n: BundleSize, cur: Currency) => {
  const p = prices[cur]; const f = (c: number) => formatMoney(c, cur);
  if (n === 1) return `Add a second ${l.noun[0]} for ${f(p[2] - p[1] - p.ship[1])} more and shipping is free.`;
  if (n === 2) return `Make it three for just ${f(p[3] - p[2])} more.`;
  return `Best value: ${f(Math.round(p[3] / 3))} each.`;
};
const defaultOption = packOption(DEFAULT);
const choosesColour = l.picks.length > 1;
const ships = l.ships ?? `Ships in ${site.shipsIn}`;
const returnsDays = l.returnsDays ?? 30;
const promises = l.promises ?? [
  ['Made for you, not pulled off a shelf', `Hui starts yours when you order and it’s on its way within ${site.shipsIn}, with tracking.`],
  ['Love it, or send it back', `You have ${returnsDays} days from delivery. We refund it, shipping included.`],
];

// Photos.
const pic = (src: string) => landerImage(src);
const thumbs = await Promise.all(
  (l.colours?.cards ?? []).map(async (c) => ({ pick: c.pick, src: (await getImage({ src: pic(c.image.src), width: 112, height: 112, fit: 'cover', format: 'webp' })).src })),
);
const stickyThumb = (await getImage({ src: pic(l.hero.image.src), width: 96, height: 96, fit: 'cover', format: 'webp' })).src;

// The character's own little logo (public/go/<slug>-mark.svg): bundle cards, footer, tab icon.
const mark = `/go/${l.slug}-mark.svg`;
const nav: [string, string][] = [['#fits', 'What fits'], ...(l.colours ? [['#colours', 'Colours'] as [string, string]] : []), ['#craft', 'Made by hand'], ['#offer', 'Bundles'], ['#faq', 'Questions']];
const config = { prices, picks: l.picks, noun: l.noun, defaults: l.offer.defaults, start: DEFAULT, cartOptions: l.cart?.options ?? null };
---
<LanderLayout title={l.title} description={l.description} image={absoluteUrl(l.og)} bar={l.bar} barRight={l.barRight} nav={nav} mark={mark}>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <symbol id="star" viewBox="0 0 16 16"><path d="M8 .9l2.2 4.5 5 .7-3.6 3.5.9 5L8 12.3l-4.5 2.3.9-5L.8 6.1l5-.7z" /></symbol>
  </svg>

  <header class="l-hero" id="top">
    <div class="container l-hero-grid">
      <div class="l-hero-copy">
        <h1>{l.hero.h1} <em>{l.hero.h1em}</em></h1>
        <p class="l-hero-sub">{l.hero.sub}</p>
        <a class="btn btn-primary l-cta" href="#offer">Choose your bundle <small>· from <span class="money" data-gbp={from.gbp} data-usd={from.usd}>{from.text}</span></small></a>
        <p class="l-proof">
          <a href="#reviews"><span class="l-stars" role="img" aria-label="Rated 5 out of 5">{[1, 2, 3, 4, 5].map(() => <svg><use href="#star" /></svg>)}</span> {site.proof.etsyRating} on Etsy</a>
          <span>“{quoteText(heroQuote)}”</span>
        </p>
        <p class="small muted">Free shipping on 2 or more · {returnsDays}-day returns · {ships}</p>
      </div>
      <div class="l-hero-art">
        <Picture src={pic(l.hero.image.src)} alt={l.hero.image.alt} widths={[480, 800, 1100]} sizes="(max-width: 56rem) 92vw, 540px" formats={['webp']} loading="eager" fetchpriority="high" class="l-photo" />
      </div>
    </div>
  </header>

  <section class="l-sec" id="why">
    <div class="container l-narrow l-prose">
      <h2>{l.story.h}</h2>
      {l.story.paras.map((p) => <p>{p}</p>)}
      <h3>{l.story.subH}</h3>
      {l.story.subParas.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="l-sec l-tint" id="fits">
    <div class="container l-split">
      <div>
        <h2>{l.fits.h}</h2>
        <p class="lead">{l.fits.lede}</p>
        <dl class="l-specs">
          {l.fits.specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </div>
      <figure class="l-framed">
        <Picture src={pic(l.fits.image.src)} alt={l.fits.image.alt} widths={[480, 800]} sizes="(max-width: 56rem) 92vw, 520px" formats={['webp']} class="l-photo" />
      </figure>
    </div>
  </section>

  {l.colours && (
  <section class="l-sec" id="colours">
    <div class="container">
      <div class="l-narrow l-center">
        <h2>{l.colours.h}</h2>
        <p class="lead">{l.colours.lede}</p>
      </div>
      <div class={`l-colours l-colours-${l.colours.cards.length}`}>
        {l.colours.cards.map((c) => (
          <article class="l-colour">
            <Picture src={pic(c.image.src)} alt={c.image.alt} widths={[400, 700]} sizes="(max-width: 40rem) 92vw, 360px" formats={['webp']} class="l-photo" />
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </article>
        ))}
      </div>
      <p class="l-center l-note">{l.colours.note}</p>
    </div>
  </section>
  )}

  <section class="l-sec l-tint" id="uses">
    <div class="container">
      <div class="l-narrow">
        <h2>{l.uses.h}</h2>
        <ul class="l-uses" role="list">
          {l.uses.items.map(([b, t]) => <li><b>{b}</b> {t}</li>)}
        </ul>
      </div>
      {l.uses.images && l.uses.images.length > 0 && <div class="l-strip">
        {l.uses.images.map((im) => <Picture src={pic(im.src)} alt={im.alt} widths={[360, 640]} sizes="(max-width: 40rem) 46vw, 340px" formats={['webp']} class="l-photo" />)}
      </div>}
    </div>
  </section>

  <section class="l-sec l-dark" id="craft">
    <div class="container l-split l-split-rev">
      <figure class="l-framed">
        <Picture src={pic(l.craft.image.src)} alt={l.craft.image.alt} widths={[480, 800]} sizes="(max-width: 56rem) 92vw, 520px" formats={['webp']} class="l-photo" />
      </figure>
      <div>
        <h2>{l.craft.h}</h2>
        {l.craft.paras.map((p) => <p class="lead">{p}</p>)}
        {l.maker === 'Hui' && <p><a href="/our-story/">Meet Hui</a></p>}
      </div>
    </div>
  </section>

  <section class="l-sec" id="offer">
    <div class="container">
      <div class="l-narrow l-center">
        <h2>{l.offer.h}</h2>
        <p class="lead">{l.offer.lede}</p>
      </div>

      <div class="l-offers" role="group" aria-label="Choose a bundle">
        {BUNDLE_SIZES.map((n) => {
          const p = bundlePrice(n); const per = perPiece(n); const save = saving(n);
          return (
            <button class={`l-offer${n === DEFAULT ? ' l-best' : ''}`} type="button" data-qty={n} aria-pressed={n === DEFAULT ? 'true' : 'false'}>
              <span class="l-tick" aria-hidden="true">Selected</span>
              <span class="l-marks" aria-hidden="true">{Array.from({ length: n }, () => <img src={mark} alt="" width="34" height="34" />)}</span>
              {n === 2 && <span class="l-flag">{l.offer.flag2}</span>}
              <span class="l-qty">{n} {nounFor(n)}</span>
              <span class="l-amount money" data-gbp={p.gbp} data-usd={p.usd}>{p.text}</span>
              {n === 1 ? (
                <span class="l-per">plus <span class="money" data-gbp={singleShip.gbp} data-usd={singleShip.usd}>{singleShip.text}</span> shipping</span>
              ) : (
                <span class="l-per"><span class="money" data-gbp={per.gbp} data-usd={per.usd}>{per.text}</span> each · save <span class="money" data-gbp={save.gbp} data-usd={save.usd}>{save.text}</span></span>
              )}
              {n > 1 && <span class="l-free">Free shipping</span>}
              <span class="l-onote">{l.offer.notes[n]}</span>
            </button>
          );
        })}
      </div>

      <form class="l-buy" id="buyForm" method="post" action="/bag/add/">
        <input type="hidden" name="slug" value={cartSlug} />
        <input type="hidden" name="qty" value="1" />
        <input type="hidden" name="option" id="optField" value={defaultOption} />
        {choosesColour && <fieldset class="l-picks">
          <legend>Choose each {l.noun[0]}</legend>
          {[0, 1, 2].map((row) => (
            <div class="l-pick-row" data-row={row} hidden={row >= DEFAULT}>
              <span class="l-pick-label" id={`pick-label-${row}`}>{Noun} {row + 1}</span>
              <div class="l-chips" role="radiogroup" aria-labelledby={`pick-label-${row}`}>
                {thumbs.map((t) => (
                  <label class="l-chip">
                    <input type="radio" name={`pick${row}`} value={t.pick} checked={t.pick === l.offer.defaults[row]} disabled={row >= DEFAULT} />
                    <img src={t.src} alt="" width="56" height="56" decoding="async" />
                    <span>{t.pick}</span>
                  </label>
                ))}
              </div>
            </div>
          ))}
        </fieldset>}

        <div class="l-proofbar">
          <span class="l-stars" role="img" aria-label="Rated 5 out of 5">{[1, 2, 3, 4, 5].map(() => <svg><use href="#star" /></svg>)}</span>
          <p>“{quoteText(offerQuote)}” <span class="muted">{offerQuote.reviewer}, Etsy</span></p>
        </div>

        <p class="l-nudge" id="nudge" aria-live="polite">{nudge(DEFAULT, 'EUR')}</p>
        <button class="btn btn-primary l-buy-btn" type="submit" id="buyBtn">Add to basket · <span class="money" data-gbp={bundlePrice(DEFAULT).gbp} data-usd={bundlePrice(DEFAULT).usd}>{bundlePrice(DEFAULT).text}</span></button>
        <p class="small l-center">
          <b id="selLabel">{defaultOption}</b> · <span id="shipLine">free shipping</span> · {returnsDays}-day returns<br />
          {ships}, with tracking · Pay with PayPal or card
        </p>
      </form>
    </div>
  </section>

  <section class="l-sec l-dark">
    <div class="container">
      <h2 class="l-center">Two promises</h2>
      <div class="l-promises l-promises-2">
        {promises.map(([h, t]) => <div><h3>{h}</h3><p>{t}</p></div>)}
      </div>
    </div>
  </section>

  <section class="l-sec" id="reviews">
    <div class="container">
      <div class="l-narrow l-center">
        <h2>{site.proof.etsyRating} stars from Sunnie Designs buyers</h2>
        <p class="lead">Star Seller on Etsy, and {site.proof.ebayPositive} positive from {site.proof.ebayCount} eBay ratings.</p>
      </div>
      <div class="quotes l-quotes">
        {shown.map((r) => <ReviewQuote review={r} />)}
      </div>
      <p class="l-center"><a href="/reviews/">Read more reviews</a></p>
    </div>
  </section>

  <section class="l-sec l-tint" id="faq">
    <div class="container l-narrow">
      <h2>Questions</h2>
      {l.faq.map((f, i) => (
        <details class="l-faq" open={i === 0}>
          <summary>{f.q}</summary>
          <p set:html={f.a} />
        </details>
      ))}
      <div class="l-center l-close">
        <p>Made by hand. {ships}. If it isn’t what you hoped for, you have {returnsDays} days to send it back.</p>
        <a class="btn btn-primary l-cta" href="#offer">Choose your bundle <small>· from <span class="money" data-gbp={from.gbp} data-usd={from.usd}>{from.text}</span></small></a>
        {l.productSlug && <p class="small"><a href={`/products/${l.productSlug}/`}>See the full product page</a></p>}
      </div>
    </div>
  </section>

  <div class="l-sticky" id="sticky" aria-hidden="true" inert>
    <div class="container l-sticky-in">
      <span class="l-sticky-label"><img src={stickyThumb} alt="" width="48" height="48" loading="lazy" /><span><b id="stickySel">{DEFAULT} {nounFor(DEFAULT)}</b><small id="stickyShip">Free shipping</small></span></span>
      <button class="btn btn-primary" type="button" id="stickyBtn">Add to basket</button>
    </div>
  </div>

  <script is:inline type="application/json" id="lander-config" set:html={JSON.stringify(config).replace(/</g, '\\u003c')} />
  <script is:inline>
  (function () {
    'use strict';
    var C = JSON.parse(document.getElementById('lander-config').textContent);
    var d = document.documentElement;
    var LOCALE = { EUR: 'en-IE', GBP: 'en-GB', USD: 'en-US' };
    var state = { qty: C.start, picks: C.defaults.slice() };
    var $ = function (id) { return document.getElementById(id); };
    var offers = [].slice.call(document.querySelectorAll('.l-offer'));
    var rows = [].slice.call(document.querySelectorAll('.l-pick-row'));
    var form = $('buyForm');

    function cur() { return C.prices[d.dataset.cur] ? d.dataset.cur : 'EUR'; }
    function money(cents) {
      var c = cur();
      var whole = cents % 100 === 0; // same as formatMoney(): €20, not €20.00
      return new Intl.NumberFormat(LOCALE[c], { style: 'currency', currency: c, minimumFractionDigits: whole ? 0 : 2, maximumFractionDigits: whole ? 0 : 2 }).format(cents / 100);
    }
    function noun(n) { return n === 1 ? C.noun[0] : C.noun[1]; }
    function nudge(n) {
      var p = C.prices[cur()];
      if (n === 1) return 'Add a second ' + C.noun[0] + ' for ' + money(p[2] - p[1] - p.ship[1]) + ' more and shipping is free.';
      if (n === 2) return 'Make it three for just ' + money(p[3] - p[2]) + ' more.';
      return 'Best value: ' + money(Math.round(p[3] / 3)) + ' each.';
    }
    // Must match bundleOption() in src/lib/bundles.ts: picks in picker order.
    function option() {
      if (C.cartOptions) return C.cartOptions[state.qty];
      var chosen = state.picks.slice(0, state.qty).sort(function (a, b) { return C.picks.indexOf(a) - C.picks.indexOf(b); });
      return state.qty + ' ' + noun(state.qty) + ': ' + chosen.join(' + ');
    }

    function render() {
      var p = C.prices[cur()], total = p[state.qty], ship = p.ship[state.qty];
      offers.forEach(function (b) { b.setAttribute('aria-pressed', String(+b.dataset.qty === state.qty)); });
      rows.forEach(function (r, i) {
        var on = i < state.qty;
        r.hidden = !on;
        r.querySelectorAll('input').forEach(function (inp) { inp.disabled = !on; inp.checked = inp.value === state.picks[i]; });
      });
      var opt = option();
      $('optField').value = opt;
      $('selLabel').textContent = opt;
      $('shipLine').textContent = ship ? 'plus ' + money(ship) + ' shipping' : 'free shipping';
      $('buyBtn').textContent = 'Add to basket · ' + money(total);
      $('nudge').textContent = nudge(state.qty);
      $('stickySel').textContent = state.qty + ' ' + noun(state.qty) + ' · ' + money(total);
      $('stickyShip').textContent = ship ? '+' + money(ship) + ' shipping' : 'Free shipping';
    }

    offers.forEach(function (b) {
      b.addEventListener('click', function () { state.qty = +b.dataset.qty; render(); });
    });
    rows.forEach(function (r, i) {
      r.addEventListener('change', function (e) {
        if (e.target && e.target.name === 'pick' + i && C.picks.indexOf(e.target.value) >= 0) { state.picks[i] = e.target.value; render(); }
      });
    });
    $('stickyBtn').addEventListener('click', function () {
      if (form.requestSubmit) form.requestSubmit(); else form.submit();
    });

    // Sticky bar: after the hero, hidden while the offer is on screen.
    var sticky = $('sticky'), hero = document.querySelector('.l-hero'), offerEl = $('offer');
    var heroGone = false, offerOn = false;
    function sync() {
      var show = heroGone && !offerOn;
      if (!show && sticky.contains(document.activeElement)) $('buyBtn').focus();
      sticky.classList.toggle('show', show);
      sticky.inert = !show;
      sticky.setAttribute('aria-hidden', String(!show));
      document.body.classList.toggle('sticky-open', show);
    }
    window.addEventListener('scroll', function () { heroGone = hero.getBoundingClientRect().bottom < 60; sync(); }, { passive: true });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (e) { offerOn = e[e.length - 1].isIntersecting; sync(); }, { rootMargin: '0px 0px -15% 0px' }).observe(offerEl);
    }
    render();
    sync();
  })();
  </script>
</LanderLayout>
