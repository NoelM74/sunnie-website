---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqList from '../components/FaqList.astro';
import ProductGrid from '../components/ProductGrid.astro';
import TrustBar from '../components/TrustBar.astro';
import ReviewQuote from '../components/ReviewQuote.astro';
import reviews from '../data/reviews.json';
import storyPhoto from '../assets/story/hui.jpg';
import { site } from '../data/site';
import { featured, showHatsInNav } from '../lib/products';
import Money from '../components/Money.astro';
import { faqJsonLd, organizationJsonLd, websiteJsonLd } from '../lib/seo';
import { freeShippingAll } from '../lib/money';
import { BUNDLE_PRICES, priceBook } from '../lib/bundles';
import { landerBySlug } from '../data/landers';
import { landerImage } from '../lib/lander-images';
import { LANDER_PRODUCT_SLUGS } from '../lib/lander-products';

const FREE_SHIPPING = freeShippingAll();

const all = await getCollection('products');
// Bestsellers: the four best-selling character bags (one frog only, owner 2026-11-12), each with its own bundle page. "More to love"
// keeps the shop's other favourites on the page.
const characters = [
  { slug: 'star-frogs', name: 'The Star Frogs', blurb: 'A frog in overalls that carries your phone. Pink, blue or brown.', img: 'products/frog-phone-crossbody/frog-phone-crossbody-01.jpg' },
  { slug: 'big-mouth-monsters', name: 'Big Mouth Monsters', blurb: 'A fuzzy monster with a mouth for your phone. Pink or yellow.', img: 'landers/big-mouth-monsters/big-mouth-monsters-pair-step.webp' },
  { slug: 'miso-cat', name: 'Miso the cat', blurb: 'A cat in a sweater for your keys and lip balm. Black, brown or yellow.', img: 'products/cat-crossbody-bag-with-dangling-legs/cat-crossbody-bag-with-dangling-legs-01.webp' },
  { slug: 'snout-and-about', name: 'Snout & About', blurb: 'A soft little dog that carries your phone. Schnauzer, puppy or terrier.', img: 'landers/snout-and-about/snout-and-about-life-4.webp' },
].map((c) => {
  const book = priceBook(landerBySlug(c.slug)!);
  return { ...c, href: `/go/${c.slug}/`, mark: `/go/${c.slug}-mark.svg`, book };
});
const two = BUNDLE_PRICES.EUR.packs[2] / 100;
const best = featured(all).filter((p) => !LANDER_PRODUCT_SLUGS.includes(p.id));
const hero = { href: '/go/snout-and-about/', img: landerImage('landers/snout-and-about/snout-and-about-trio.webp'), alt: 'Three soft crochet dog bags on a wooden shelf: a grey schnauzer, a beige puppy and a white terrier' };
const coaster = best.find((p) => p.data.category === 'coasters') ?? best[2];

const homeFaq = [
  {
    q: 'Where do I buy from Sunnie Designs?',
    a: `Right here: add pieces to your basket and pay in euro, pounds or dollars with PayPal or any card, no account needed. Shipping is free on orders of ${FREE_SHIPPING} or more, and every order comes with 30-day returns. There are no import charges on delivery to the EU, UK or US.`,
  },
  {
    q: 'Who makes the pieces?',
    a: `${site.makerLine}, who designs each piece and crochets it stitch by stitch. Nollaig runs the shop side: photos, packing and messages, usually answered ${site.replyTime}.`,
  },
  {
    q: 'What yarn do you use?',
    a: 'Cotton, polyester or acrylic, depending on the design. No animal wool.',
  },
  {
    q: 'How fast does it ship?',
    a: `Orders ship in ${site.shipsIn}, with tracking.`,
  },
];
const homeFaqLd = faqJsonLd(homeFaq);

const HOME_REVIEWS = ['hexfeather|2026-09-25', 'Hannah|2026-06-04', 'Antje-Susan|2026-06-02'];
const quotes = HOME_REVIEWS.map((key) => {
  const r = reviews.find((x) => `${x.reviewer}|${x.date}` === key);
  if (!r) throw new Error(`Homepage review missing from reviews.json: ${key}`);
  return r as (typeof reviews)[number] & { lang: 'en' | 'de' };
});

// Tiles use pieces not already shown in Bestsellers, so the page never repeats a photo.
const notShown = (test: (p: (typeof all)[number]) => boolean) => all.find((p) => test(p) && p.data.inStock && !best.includes(p) && !LANDER_PRODUCT_SLUGS.includes(p.id));
const hasHats = showHatsInNav(all);
const tiles = [
  { label: 'Bags', href: '/shop/bags/', img: landerImage('landers/finn-in-the-hood/finn-in-the-hood-life-3.webp') },
  { label: 'Coasters', href: '/shop/coasters/', img: (notShown((p) => p.data.category === 'coasters') ?? coaster).data.images[0].src },
  ...(hasHats
    ? [{ label: 'Hats', href: '/shop/hats/', img: all.find((p) => p.data.category === 'hats')!.data.images[0].src }]
    : []),
];
---
<BaseLayout
  alternates={[{ lang: 'en', href: '/' }, { lang: 'de', href: '/de/' }]}
  title="Sunnie Designs | Handmade crochet bags and coasters"
  description={site.description}
  path="/"
  jsonLd={[organizationJsonLd(), websiteJsonLd(), ...(homeFaqLd ? [homeFaqLd] : [])]}
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="hero-eyebrow">Hand-crocheted character bags</p>
        <h1 class="hero-title">
          Carry a little
          <span class="hero-joy">joy<svg viewBox="0 0 120 14" preserveAspectRatio="none" aria-hidden="true"><path d="M3 9 C 22 2, 38 13, 58 7 S 96 3, 117 8" pathLength="1" /></svg></span>.
        </h1>
        <p class="hero-sub">
          Frogs, cats and dogs, {site.heroMakerClause}. Room for your phone and your keys, and a face that makes
          people ask where you got it. Pick any two bags and shipping is free.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#bestsellers">Meet the bestsellers</a>
          <a class="btn-ghost" href="/shop/bags/">Shop all bags</a>
        </div>
        <p class="hero-trust">
          <span class="hero-stars" aria-hidden="true">★★★★★</span>
          Rated {site.proof.etsyRating} by our buyers · {site.proof.ebayPositive} positive across {site.proof.ebayCount} eBay ratings
        </p>
      </div>
      <a class="hero-media" href={hero.href}>
        <span class="hero-sun" aria-hidden="true"></span>
        <span class="hero-sticker" aria-hidden="true">made<br />by hand</span>
        <Picture
          src={hero.img}
          alt={hero.alt}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 56rem) 46vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero-caption">Snout &amp; About · 2 for <Money eur={two} gbpCents={BUNDLE_PRICES.GBP.packs[2]} usdCents={BUNDLE_PRICES.USD.packs[2]} /></span>
      </a>
    </div>
  </section>

  <TrustBar />

  <section class="section" id="bestsellers" aria-labelledby="best-h">
    <div class="container">
      <div class="section-head">
        <h2 id="best-h">Bestsellers</h2>
        <a href="/shop/bags/">Shop all bags</a>
      </div>
      <p class="lead">Four characters, each crocheted by hand. Pick two and shipping is free.</p>
      <ul class="chars" role="list">
        {characters.map((c) => (
          <li>
            <a class="char" href={c.href}>
              <span class="char-media">
                <Picture src={landerImage(c.img)} alt={landerBySlug(c.slug)!.name} formats={['avif', 'webp']} widths={[360, 600, 800]} sizes="(min-width: 64rem) 270px, (min-width: 40rem) 45vw, 92vw" loading="lazy" />
                <img class="char-mark" src={c.mark} alt="" width="52" height="52" loading="lazy" />
              </span>
              <span class="char-name">{c.name}</span>
              <span class="char-blurb">{c.blurb}</span>
              <span class="char-price">
                <Money eur={c.book.EUR[1] / 100} gbpCents={c.book.GBP[1]} usdCents={c.book.USD[1]} /> · 2 for <Money eur={c.book.EUR[2] / 100} gbpCents={c.book.GBP[2]} usdCents={c.book.USD[2]} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="more-h">
    <div class="container">
      <div class="section-head">
        <h2 id="more-h">More to love</h2>
        <a href="/shop/">Shop all</a>
      </div>
      <ProductGrid products={best} />
    </div>
  </section>

  <section class="section section-sand" aria-labelledby="story-h">
    <div class="container story">
      <Picture src={storyPhoto} alt="Hui, who designs and crochets every Sunnie Designs piece, at a café window beside a vase of orange flowers" formats={['avif', 'webp']} widths={[480, 800]} sizes="(min-width: 56rem) 40vw, 100vw" loading="lazy" class="story-img" style="object-position: 50% 20%" />
      <div>
        <h2 id="story-h">{site.makerLine}, one stitch at a time</h2>
        <p class="lead">
          Every piece is worked stitch by stitch, from the first row to the last knot. Hand-worked
          yarn means small differences from the photos, a centimetre or two, the kind of imperfection that makes a
          piece yours.
        </p>
        <p>
          Our buyers rate us {site.proof.etsyRating} out of 5. Every order helps keep slow, handmade craft
          going.
        </p>
        <p><a href="/our-story/">Read our story</a></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cats-h">
    <div class="container">
      <h2 id="cats-h">Shop by type</h2>
      <p class="lead">Bags for every day and coasters for the table{hasHats && <>, <a href="/shop/hats/">hats</a> for cold snaps</>}.</p>
      <ul class="tiles" role="list" style={`--tile-cols: ${tiles.length}`}>
        {tiles.map((t) => (
          <li>
            <a class="tile" href={t.href}>
              <Picture src={t.img} alt={`Crochet ${t.label.toLowerCase()}`} formats={['avif', 'webp']} widths={[400, 800]} sizes="(min-width: 56rem) 50vw, (min-width: 40rem) 50vw, 100vw" loading="lazy" />
              <span class="tile-label">{t.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-sand" aria-labelledby="reviews-h">
    <div class="container">
      <div class="section-head">
        <h2 id="reviews-h">What buyers say</h2>
        <a href="/reviews/">Read all reviews</a>
      </div>
      <p class="lead">Every quote here comes from a real buyer, word for word.</p>
      <div class="quotes">
        {quotes.map((r) => <ReviewQuote review={r} />)}
      </div>
    </div>
  </section>

  <div class="section">
    <div class="container">
      <FaqList items={homeFaq} heading="Good to know" />
    </div>
  </div>
</BaseLayout>
