---
import NoBreakHyphens from '../components/NoBreakHyphens.astro';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-sans-3';
import headingWoff2 from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import bodyWoff2 from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import JsonLd from '../components/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/lang';
import { SHOP_UI } from '../i18n/shop-ui';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  type?: 'website' | 'product';
  noindex?: boolean;
  canonical?: boolean;
  jsonLd?: object[];
  current?: 'bags' | 'coasters' | 'hats' | 'story' | 'shop' | 'reviews';
  lang?: Lang;
  /** The same page in each language (hreflang). */
  alternates?: { lang: string; href: string }[];
}
const { jsonLd = [], current, path = Astro.url.pathname, lang = 'en', ...seo } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={headingWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyWoff2} as="font" type="font/woff2" crossorigin />
    {/* Pick the price currency before first paint: saved choice, else a guess from the time zone (UK: pounds, US: dollars, rest: euro). Crawlers get euro, to match the product structured data. The bag and checkout read the same cookie. */}
    <script is:inline>(function(){try{var d=document.documentElement,m=/(?:^|; )sunnie_cur=(EUR|GBP|USD)(?:;|$)/.exec(document.cookie),c=m&&m[1];if(!c&&/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent)){d.dataset.cur='EUR';return}if(!c){var z=Intl.DateTimeFormat().resolvedOptions().timeZone||'';c=/^Europe\/(London|Belfast|Isle_of_Man|Jersey|Guernsey)$/.test(z)?'GBP':/^(America\/(New_York|Chicago|Denver|Los_Angeles|Phoenix|Anchorage|Juneau|Sitka|Nome|Yakutat|Metlakatla|Adak|Boise|Detroit|Menominee|Puerto_Rico|Indiana\/\w+|Kentucky\/\w+|North_Dakota\/\w+)|Pacific\/Honolulu)$/.test(z)?'USD':'EUR';document.cookie='sunnie_cur='+c+';path=/;max-age=31536000;samesite=lax;secure'}d.dataset.cur=c}catch(e){}})();</script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FBF6EE" />
    <Seo path={path} {...seo} locale={lang === 'de' ? 'de_DE' : undefined} />
    {jsonLd.length > 0 && <JsonLd data={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{SHOP_UI[lang].skip}</a>
    <Header current={current} lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    {/* Swap euro prices for pounds or dollars (data attributes on .money, see Money.astro). */}
    <script is:inline>(function(){var d=document.documentElement;window.sunnieMoney=function(){var k=d.dataset.cur==='GBP'?'gbp':d.dataset.cur==='USD'?'usd':'';document.querySelectorAll('.money').forEach(function(m){if(!m.dataset.eur)m.dataset.eur=m.textContent;m.textContent=k?m.dataset[k]:m.dataset.eur})};window.sunnieMoney()})();</script>
  <NoBreakHyphens />
  </body>
</html>
