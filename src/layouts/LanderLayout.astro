---
import NoBreakHyphens from '../components/NoBreakHyphens.astro';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-sans-3';
import headingWoff2 from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import bodyWoff2 from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import logo from '../assets/brand/logo-wordmark.svg?raw';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/lander.css';
import Seo from '../components/Seo.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../data/site';
import { LANG_COOKIE, type Lang } from '../i18n/lang';
import { LAYOUT_UI } from '../i18n/lander-ui';

// Bundle landers (/go/<slug>/): the shop's look, fonts, currency and basket, with a slim
// header so the offer stays the focus. Each is the product's only page, so it's indexed.
interface Props { title: string; description: string; image: string; bar: string; barRight?: string; nav: [string, string][]; mark?: string; jsonLd?: object[]; shop?: [string, string]; lang?: Lang; alternates?: { lang: string; href: string }[] }
const { title, description, image, bar, barRight = site.makerLine, nav, mark, jsonLd = [], lang = 'en', alternates = [] } = Astro.props;
const U = LAYOUT_UI[lang];
const shop = Astro.props.shop ?? ['/shop/bags/', U.allBags];
// The same page in the other language, for the footer switch.
const other = alternates.find((a) => a.lang === U.other.lang);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={headingWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyWoff2} as="font" type="font/woff2" crossorigin />
    {/* Same currency pick as BaseLayout: saved choice, else a guess from the time zone. */}
    <script is:inline>(function(){try{var d=document.documentElement,m=/(?:^|; )sunnie_cur=(EUR|GBP|USD)(?:;|$)/.exec(document.cookie),c=m&&m[1];if(!c&&/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent)){d.dataset.cur='EUR';return}if(!c){var z=Intl.DateTimeFormat().resolvedOptions().timeZone||'';c=/^Europe\/(London|Belfast|Isle_of_Man|Jersey|Guernsey)$/.test(z)?'GBP':/^(America\/(New_York|Chicago|Denver|Los_Angeles|Phoenix|Anchorage|Juneau|Sitka|Nome|Yakutat|Metlakatla|Adak|Boise|Detroit|Menominee|Puerto_Rico|Indiana\/\w+|Kentucky\/\w+|North_Dakota\/\w+)|Pacific\/Honolulu)$/.test(z)?'USD':'EUR';document.cookie='sunnie_cur='+c+';path=/;max-age=31536000;samesite=lax;secure'}d.dataset.cur=c}catch(e){}})();</script>
    <link rel="icon" href={mark ?? '/favicon.svg'} type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FBF6EE" />
    <Seo title={title} description={description} path={Astro.url.pathname} image={image} type="product" alternates={alternates} locale={lang === 'de' ? 'de_DE' : undefined} />
    {/* The bag and checkout follow the language of the last page you shopped on. */}
    <script is:inline define:vars={{ c: `${LANG_COOKIE}=${lang};path=/;max-age=31536000;samesite=lax;secure` }}>try{document.cookie=c}catch(e){}</script>
    {jsonLd.length > 0 && <JsonLd data={jsonLd} />}
  </head>
  <body class="lander">
    <a class="skip-link" href="#main">{U.skip}</a>
    <aside class="l-bar" aria-label={lang === 'de' ? 'Hinweis' : 'Notice'}>{bar} <span aria-hidden="true">|</span> <b>{barRight}</b></aside>
    <header class="l-head">
      <div class="container l-head-in">
        <a href="/" class="brand" aria-label={U.home}><Fragment set:html={logo} /></a>
        <nav class="l-nav" aria-label={U.onPage}>
          {nav.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
        <a class="l-shop" href={shop[0]}>{shop[1]}</a>
        <a class="l-bag" href="/bag/">{U.basket}</a>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer l-foot">
      <div class="container l-foot-in">
        <p class="footer-brand l-foot-brand">{mark && <img src={mark} alt="" width="40" height="40" />}{site.name}</p>
        <nav aria-label={U.help}>
          {U.links.map(([href, label]) => <a href={href}>{label}</a>)}
          {other && <a href={other.href} hreflang={other.lang} lang={other.lang}>{U.other.label}</a>}
        </nav>
        <p class="small">{U.note}</p>
        <p class="footer-legal">© {year} {U.legal(site.name, site.company.legalName, site.company.cro, site.company.registeredOffice)} <a href={`mailto:${site.email.hello}`}>{site.email.hello}</a></p>
      </div>
    </footer>
    <script is:inline>(function(){var d=document.documentElement;window.sunnieMoney=function(){var k=d.dataset.cur==='GBP'?'gbp':d.dataset.cur==='USD'?'usd':'';document.querySelectorAll('.money').forEach(function(m){if(!m.dataset.eur)m.dataset.eur=m.textContent;m.textContent=k?m.dataset[k]:m.dataset.eur})};window.sunnieMoney()})();</script>
  <NoBreakHyphens />
  </body>
</html>
