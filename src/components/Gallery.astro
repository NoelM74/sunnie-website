---
import { Picture } from 'astro:assets';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  name: string;
}
const { images, name } = Astro.props;
---
<div class="gallery">
  <ul class="gallery-main" role="list" aria-label={`Photos of ${name}`}>
    {images.map((img, i) => (
      <li class="gallery-slide" id={`photo-${i + 1}`}>
        <Picture
          src={img.src}
          alt={img.alt}
          formats={i === 0 ? ['avif', 'webp'] : ['webp']}
          {...(i === 0 ? {} : { fallbackFormat: 'webp' })}
          widths={[480, 800, 1200]}
          sizes="(min-width: 56rem) 52vw, 100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          {...(i === 0 ? { fetchpriority: 'high' } : {})}
        />
        {images.length > 1 && <span class="gallery-count" aria-hidden="true">{i + 1} / {images.length}</span>}
      </li>
    ))}
  </ul>
  {images.length > 1 && (
    <ul class="gallery-thumbs" role="list">
      {images.map((img, i) => (
        <li>
          <a href={`#photo-${i + 1}`} aria-label={`Show photo ${i + 1} of ${images.length}`}>
            <Picture src={img.src} alt="" formats={['webp']} fallbackFormat="webp" widths={[96, 192]} sizes="96px" loading="lazy" decoding="async" />
          </a>
        </li>
      ))}
    </ul>
  )}
</div>
{/* Picking a colour, design or size shows its photo (radio inputs carry data-photo, see BuyBox). */}
<script is:inline>(function(){var m=document.querySelector('.gallery-main');if(!m)return;document.addEventListener('change',function(e){var t=e.target;if(!t||t.name!=='option'||t.dataset.photo===undefined)return;var reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;m.scrollTo({left:Number(t.dataset.photo)*m.clientWidth,behavior:reduce?'auto':'smooth'})})})();</script>
