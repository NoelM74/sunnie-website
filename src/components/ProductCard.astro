---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Money from './Money.astro';
import { packFor, productHref } from '../lib/lander-products';
import { germanHref, germanName } from '../i18n/de/catalog';

interface Props {
  product: CollectionEntry<'products'>;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
  lang?: 'en' | 'de';
}
const { product, headingLevel = 'h3', eager = false, lang = 'en' } = Astro.props;
const { price, inStock, isNew, images } = product.data;
const de = lang === 'de';
const name = de ? germanName(product.id, product.data.name) : product.data.name;
const href = (de && germanHref(product.id)) || productHref(product.id);
const Heading = headingLevel;
const pack = packFor(product.id);
const badge = !inStock ? (de ? 'Ausverkauft' : 'Sold out') : isNew ? (de ? 'Neu' : 'New') : null;
---
<article class="card">
  <a class="card-link" href={href}>
    <div class="card-media">
      <Picture
        src={images[0].src}
        alt={de ? name : images[0].alt}
        formats={['avif', 'webp']}
        widths={[300, 450, 600]}
        sizes="(min-width: 72rem) 270px, (min-width: 40rem) 30vw, 46vw"
        loading={eager ? 'eager' : 'lazy'}
      />
      {badge && <span class="badge card-badge">{badge}</span>}
    </div>
    <Heading class="card-title">{name}</Heading>
  </a>
  <p class="card-price">{pack ? <Money eur={pack.price.eur / 100} gbpCents={pack.price.gbp} usdCents={pack.price.usd} lang={lang} /> : <Money eur={price} lang={lang} />}</p>
</article>
