---
import { site } from '../data/site';
import Money from './Money.astro';
import FreeShippingFrom from './FreeShippingFrom.astro';
---
<section class="trust" aria-label="Why buy from us">
  <ul class="container trust-list" role="list">
    <li><strong>Free shipping from <FreeShippingFrom /></strong><span>Ships in {site.shipsIn}</span></li>
    <li><strong><span class="trust-star" aria-hidden="true">★ </span>{site.proof.etsyRating} out of 5</strong><span><a href="/reviews/">from our buyers</a></span></li>
    <li><strong>30-day returns</strong><span>On every piece</span></li>
    <li><strong>{site.makerLine}</strong><span>Made to order</span></li>
  </ul>
</section>
