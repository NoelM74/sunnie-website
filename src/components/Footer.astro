---
import { site } from '../data/site';
import type { Lang } from '../i18n/lang';
import { SHOP_UI } from '../i18n/shop-ui';
interface Props { lang?: Lang }
const F = SHOP_UI[Astro.props.lang ?? 'en'].footer;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">{site.name}</p>
      <p>{F.ships(site.makerLine, site.shipsIn)}</p>
      <p><a href={`mailto:${site.email.hello}`}>{site.email.hello}</a></p>
    </div>
    <nav aria-label={F.shop}>
      <h2>{F.shop}</h2>
      <ul>
        <li><a href={F.bagsHref}>{F.bags}</a></li>
        <li><a href={F.coastersHref}>{F.coasters}</a></li>
        <li><a href="/shop/">{F.all}</a></li>
      </ul>
    </nav>
    <nav aria-label={F.help}>
      <h2>{F.help}</h2>
      <ul>
        <li><a href={F.shippingHref}>{F.shipping}</a></li>
        <li><a href={F.careHref}>{F.care}</a></li>
        <li><a href={F.termsHref}>{F.terms}</a></li>
        {F.impressum && <li><a href="/de/impressum/">{F.impressum}</a></li>}
        <li><a href={F.impressum ? '/de/kontakt/' : '/contact/'}>{F.contact}</a></li>
      </ul>
    </nav>
    <nav aria-label={F.about}>
      <h2>{F.about}</h2>
      <ul>
        <li><a href={F.storyHref}>{F.story}</a></li>
        <li><a href={F.reviewsHref}>{F.reviews}</a></li>
        <li><a href={F.giftsHref}>{F.gifts}</a></li>
        <li><a href="/privacy/">{F.privacy}</a></li>
        <li><a href={site.pinterestUrl} rel="noopener">Pinterest</a></li>
        <li><a href={site.facebookUrl} rel="noopener">Facebook</a></li>
      </ul>
    </nav>
  </div>
  <p class="container footer-legal">© {year} {site.name} · {site.company.legalName}, CRO {site.company.cro} · <a href={F.impressum ? '/de/impressum/' : '/contact/'}>{F.company}</a></p>
</footer>
