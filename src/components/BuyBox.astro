---
import { formatPrice } from '../lib/products';

interface Props {
  slug: string;
  option?: { name: string; values: string[] };
  inStock: boolean;
  etsyUrl?: string;
  siteCheckout?: boolean;
  optionPrices?: Record<string, number>;
}
const { slug, option, inStock, etsyUrl, siteCheckout = true, optionPrices } = Astro.props;
---
{siteCheckout === false ? (
  etsyUrl ? (
    <a class="btn btn-primary btn-block etsy-link" href={etsyUrl} rel="noopener">Buy on Etsy</a>
  ) : (
    <span class="btn btn-disabled btn-block">Not available online</span>
  )
) : inStock ? (
  <form class="buy-form" method="post" action="/bag/add/">
    <input type="hidden" name="slug" value={slug} />
    {option && (
      <fieldset class="choice">
        <legend>{option.name}</legend>
        <div class="choice-list">
          {option.values.map((v) => (
            <label class="choice-opt">
              <input type="radio" name="option" value={v} required checked={option.values.length === 1} />
              <span>{v}{optionPrices && ` · ${formatPrice(optionPrices[v])}`}</span>
            </label>
          ))}
        </div>
      </fieldset>
    )}
    <label class="qty">
      <span>Quantity</span>
      <select name="qty">
        {[1, 2, 3, 4, 5].map((n) => <option value={n}>{n}</option>)}
      </select>
    </label>
    <button class="btn btn-primary btn-block" type="submit">Add to bag</button>
    <p class="small buy-note">Free worldwide shipping on orders of €49 or more · 30-day returns</p>
  </form>
) : (
  <span class="btn btn-disabled btn-block">Sold out</span>
)}
{siteCheckout !== false && etsyUrl && (
  <p class="small"><a class="etsy-link" href={etsyUrl} rel="noopener">Also available on our Etsy shop</a></p>
)}
