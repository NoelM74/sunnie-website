---
import Money from './Money.astro';
import { site } from '../data/site';

interface Props {
  slug: string;
  option?: { name: string; values: string[] };
  inStock: boolean;
  etsyUrl?: string;
  siteCheckout?: boolean;
  optionPrices?: Record<string, number>;
  maker: string;
}
const { slug, option, inStock, etsyUrl, siteCheckout = true, optionPrices, maker } = Astro.props;
---
{siteCheckout === false ? (
  etsyUrl ? (
    <a class="btn btn-primary btn-block etsy-link" href={etsyUrl} rel="noopener">Buy on Etsy</a>
  ) : (
    <span class="btn btn-disabled btn-block">Not available online</span>
  )
) : inStock ? (
  <form class="buy-form" id="buy-form" method="post" action="/bag/add/">
    <input type="hidden" name="slug" value={slug} />
    {option && (
      <fieldset class="choice">
        <legend>{option.name}</legend>
        <div class="choice-list">
          {option.values.map((v, i) => (
            <label class="choice-opt">
              <input type="radio" name="option" value={v} required checked={i === 0} />
              <span>{v}{optionPrices && <> · <Money eur={optionPrices[v]} /></>}</span>
            </label>
          ))}
        </div>
      </fieldset>
    )}
    <div class="buy-row">
      <label class="qty">
        <span>Qty</span>
        <select name="qty">
          {[1, 2, 3, 4, 5].map((n) => <option value={n}>{n}</option>)}
        </select>
      </label>
      <button class="btn btn-primary buy-btn" type="submit" data-buy-btn>Add to basket</button>
    </div>
    <ul class="buy-ticks" role="list">
      <li><span>Made to order by {maker}, ships in {site.shipsIn} with tracking</span></li>
      <li><span>Free shipping from <Money eur={49} whole /> · 30-day returns</span></li>
      <li><span>No import charges to the EU, UK or US</span></li>
      <li><span>Pay in euro, pounds or dollars with PayPal or card</span></li>
    </ul>
  </form>
) : (
  <span class="btn btn-disabled btn-block">Sold out</span>
)}
