---
import type { CollectionEntry } from 'astro:content';
import ProductCard from './ProductCard.astro';
import { tagsFor } from '../lib/products';

interface Props {
  products: CollectionEntry<'products'>[];
  headingLevel?: 'h2' | 'h3';
  eagerFirst?: number;
}
const { products, headingLevel = 'h3', eagerFirst = 0 } = Astro.props;
---
<ul class="grid" role="list">
  {products.map((p, i) => (
    <li data-tags={tagsFor(p).join(' ')} data-price={Math.round(p.data.price * 100)} data-new={p.data.isNew ? 1 : 0} data-i={i}>
      <ProductCard product={p} headingLevel={headingLevel} eager={i < eagerFirst} />
    </li>
  ))}
</ul>
